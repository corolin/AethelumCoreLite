{
  "name": "@syrkos/aethelum-core-lite",
  "version": "1.1.5",
  "description": "模拟树神经的异步通信框架 —— 基于生物树神经概念构建的高性能消息处理架构，支持异步队列、Worker 钩子、WAL 持久化与自我优化，适用于 Bun 运行时",
  "files": [
    "dist"
  ],
  "exports": {
    "./core": "./dist/src/core/index.js",
    "./utils": "./dist/src/utils/index.js",
    "./api": "./dist/src/api/index.js",
    "./config": "./dist/src/config/index.js",
    "./prompts": "./dist/src/prompts/index.js",
    "./hooks": "./dist/src/hooks/index.js",
    "./types": "./dist/src/types/index.js"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/src/core/index.d.ts"
      ],
      "utils": [
        "dist/src/utils/index.d.ts"
      ],
      "api": [
        "dist/src/api/index.d.ts"
      ],
      "config": [
        "dist/src/config/index.d.ts"
      ],
      "prompts": [
        "dist/src/prompts/index.d.ts"
      ],
      "hooks": [
        "dist/src/hooks/index.d.ts"
      ],
      "types": [
        "dist/src/types/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "bun test --parallel=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
